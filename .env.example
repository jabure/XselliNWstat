# Kopiere diese Datei zu ".env" und trage einen eigenen, langen, zufälligen Wert ein.
# Zum Erzeugen z.B.: openssl rand -hex 32
# Bleibt das Feld leer (oder steht noch ein Platzhalter drin), erzeugt der Server
# beim ersten Start selbst ein zufälliges Secret (data/.jwt-secret) und warnt im Log.
JWT_SECRET=

# Nur dieser Benutzername darf die Presets & Formeln bearbeiten (registrier
# dich im Frontend einmal mit genau diesem Namen als dein Admin-Konto).
ADMIN_USERNAME=Xselli

# Optional: Einladungscode für neue Konten. Leer lassen = Registrierung für alle offen.
# Mit Code sehen Interessenten im Registrieren-Formular ein zusätzliches Feld.
REGISTER_CODE=

# Impressum und Datenschutzerklärung (Seiten /impressum und /datenschutz).
# Hier stehen deine echten Angaben - die .env gehört nicht ins Git.
# Adresse: mehrere Zeilen mit | trennen, z. B. LEGAL_ADDRESS=Musterweg 1 | 1010 Wien | Österreich
LEGAL_NAME=
LEGAL_ADDRESS=
LEGAL_EMAIL=
LEGAL_PHONE=
